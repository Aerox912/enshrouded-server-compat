+"""Verify Creative's shared UI host integration against the pinned client."""
+import argparse
+import hashlib
+import json
+import re
+from pathlib import Path
+import pefile
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('game')
+parser.add_argument('source', type=Path, help='Creative src/native_menu.cpp')
+parser.add_argument('--host', type=Path, help='Shared ui-host/host.cpp; defaults to sibling mod-patches')
+args = parser.parse_args()
+raw = Path(args.game).read_bytes()
+digest = hashlib.sha256(raw).hexdigest()
+if digest != 'af2f5a1227911d8aa06b3908d6bd0211838211cae14ea91099cb57d0df990781':
+    raise SystemExit('Unsupported client executable')
+source = args.source.read_text()
+if 'ui_host->register_client(&client)' not in source or 'MH_CreateHook(' in source:
+    raise SystemExit('Creative must register with the shared host and own no menu detours')
+host = args.host or args.source.resolve().parents[2] / 'enshrouded-mod-patches/native/ui-host/host.cpp'
+image = pefile.PE(data=raw).get_memory_mapped_image()
+sites = []
+pattern = r'\{(0x[0-9a-f]+),\{((?:0x[0-9a-f]+|0)(?:,(?:0x[0-9a-f]+|0))*)\},reinterpret_cast<void\*>'
+for rva, values in re.findall(pattern, host.read_text()):
+    expected = bytes(int(value, 0) for value in values.split(','))
+    offset = int(rva, 16)
+    if len(expected) != 16 or expected != image[offset:offset + 16]:
+        raise SystemExit(f'Hook mismatch at {rva}')
+    sites.append({'rva': rva, 'bytes': expected.hex()})
+if {int(site['rva'], 16) for site in sites} != {0xb25f50, 0xa971f0, 0xdb5b50, 0xa7ea00} or len(sites) != 4:
+    raise SystemExit('Expected HUD, playground, controller poll and dual-inventory hook signatures')
+print(json.dumps({'client_sha256': digest, 'shared_host': str(host), 'verified_sites': sites}, indent=2))

